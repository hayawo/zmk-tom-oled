if SHIELD_TOM_OLED

choice ZMK_DISPLAY_STATUS_SCREEN
    default ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
endchoice

config ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
    select LV_USE_LABEL
    select LV_USE_IMG
    select LV_USE_CANVAS
    select LV_USE_ANIMIMG
    select LV_USE_ANIMATION
    select LV_USE_LINE
    select LV_FONT_UNSCII_8
    select ZMK_WPM if (!ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL) && !ZMK_TOM_OLED_CODEX_STATUS
    imply ZMK_HID_INDICATORS

config ZMK_TOM_OLED_CODEX_STATUS
    bool "Replace bongo cat with Codex status"
    default n
    depends on !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL
    help
      Replace the central bongo cat widget with a Codex status widget. Enable
      ZMK Studio separately to receive status updates over its BLE transport.

config ZMK_TOM_OLED_CODEX_STATUS_STUDIO_RPC
    bool "Receive Codex status through ZMK Studio custom RPC"
    default y
    depends on ZMK_TOM_OLED_CODEX_STATUS && ZMK_STUDIO_RPC
    help
      Register the tom_oled__codex_status custom subsystem. BLE transport is
      enabled by ZMK Studio by default when ZMK BLE support is available.

config ZMK_TOM_OLED_CODEX_STATUS_DEFAULT_TTL_SEC
    int "Default Codex status timeout in seconds"
    default 120
    range 1 3600
    depends on ZMK_TOM_OLED_CODEX_STATUS_STUDIO_RPC

config ZMK_TOM_OLED_CODEX_STATUS_MAX_TTL_SEC
    int "Maximum Codex status timeout in seconds"
    default 3600
    range 1 65535
    depends on ZMK_TOM_OLED_CODEX_STATUS_STUDIO_RPC

config ZMK_TOM_OLED_DONGLE_BATTERY
    bool "Show also the battery level of the dongle"
    depends on BT && (!ZMK_SPLIT_BLE || ZMK_SPLIT_ROLE_CENTRAL)

config ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_FETCHING
    default y if ZMK_SPLIT_BLE && ZMK_SPLIT_ROLE_CENTRAL

config ZMK_TOM_OLED_MAC_MODIFIERS
    bool "Use MacOS modifier symbols instead of the Windows symbols"

choice ZMK_DISPLAY_WORK_QUEUE
    default ZMK_DISPLAY_WORK_QUEUE_DEDICATED
endchoice

config LV_Z_MEM_POOL_SIZE
    default 8192

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif
