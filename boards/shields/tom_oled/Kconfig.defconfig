if SHIELD_TOM_OLED

choice ZMK_DISPLAY_STATUS_SCREEN
    default ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
endchoice

config ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
    select LV_USE_LABEL
    select ZMK_WIDGET_BATTERY_STATUS if (!ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL)
    select LV_USE_IMG
    select LV_USE_CANVAS
    select LV_USE_ANIMIMG
    select LV_USE_ANIMATION
    select LV_USE_LINE
    select LV_FONT_UNSCII_8
    select ZMK_WPM if (!ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL)
    select ZMK_SPLIT_RELAY_EVENT if ZMK_SPLIT
    imply ZMK_HID_INDICATORS

config ZMK_TOM_OLED_CODEX_STATUS
    bool "Start central OLED in agent status mode"
    default n
    depends on !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL
    help
      Select the initial central OLED mode when there is no saved selection.
      y starts with the Codex/Claude Code status widget and n starts with Bongo
      Cat. The oled_mode key behavior can switch either mode at runtime.

config ZMK_TOM_OLED_CODEX_STATUS_STUDIO_RPC
    bool "Receive Codex status through ZMK Studio custom RPC"
    default y
    depends on ZMK_STUDIO_RPC
    help
      Register the tom_oled__codex_status custom subsystem. BLE transport is
      enabled by ZMK Studio by default when ZMK BLE support is available.

config ZMK_TOM_OLED_CODEX_STATUS_DEFAULT_TTL_SEC
    int "Default Codex status timeout in seconds"
    default 120
    range 1 3600
    depends on ZMK_TOM_OLED_CODEX_STATUS_STUDIO_RPC

config ZMK_TOM_OLED_CODEX_STATUS_MAX_TTL_SEC
    int "Maximum Codex status timeout in seconds"
    default 3600
    range 1 65535
    depends on ZMK_TOM_OLED_CODEX_STATUS_STUDIO_RPC

config ZMK_TOM_OLED_DONGLE_BATTERY
    bool "Show also the battery level of the dongle"
    depends on BT && (!ZMK_SPLIT_BLE || ZMK_SPLIT_ROLE_CENTRAL)

config ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_FETCHING
    default y if ZMK_SPLIT_BLE && ZMK_SPLIT_ROLE_CENTRAL

config ZMK_TOM_OLED_MAC_MODIFIERS
    bool "Use MacOS modifier symbols instead of the Windows symbols"

config ZMK_TOM_OLED_DIAGNOSTIC_STAGE
    int "Diagnostic widget stage"
    default 0
    range 0 8
    help
      Build only one central OLED widget for hardware diagnostics. 0 builds
      the normal screen, 1 output status, 2 Bongo Cat, 3 agent status,
      4 text widgets, 5 battery status, 6 one static output image, and
      7 all static output images. 8 combines output status, Bongo Cat, and
      the ZMK battery widget.

choice ZMK_DISPLAY_WORK_QUEUE
    default ZMK_DISPLAY_WORK_QUEUE_DEDICATED
endchoice

config LV_Z_MEM_POOL_SIZE
    default 16384

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif
